model users {
  id             String     @id @default(uuid()) @db.Uuid
  name           String
  email          String     @unique
  password       String
  role           UserRole   @default(USER)
  profile_photo  String?
  contact_number String?
  status         UserStatus @default(ACTIVE)
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
  SPECIALIST
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}
